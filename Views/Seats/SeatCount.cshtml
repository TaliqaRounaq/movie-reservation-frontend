@model CineBook.Models.SeatCountViewModel
@{
    ViewData["Title"] = "Choose seats";
}
<link rel="stylesheet" href="~/css/seat-selection.css" asp-append-version="true" />
<partial name="_Navbar" />

<main class="page-container">
    <section class="seat-count-card" aria-labelledby="seat-count-title">
        <p class="page-label">Booking details</p>
        <h1 id="seat-count-title">How many seats?</h1>
        <p class="show-info"><strong>@Model.MovieName</strong> · @Model.TheatreName · @Model.ShowDate, @Model.ShowTime (@Model.ScreenName)</p>

        <form asp-action="Index" method="get">
            <input type="hidden" name="showtimeId" value="@Model.ShowtimeId" />
            <label class="seat-count-label" for="seatCount">Number of seats</label>
            <select class="seat-count-select" id="seatCount" name="seatCount">
                @for (var count = 1; count <= 10; count++)
                {
                    <option value="@count">@count seat@(count == 1 ? string.Empty : "s")</option>
                }
            </select>
            <button class="confirm-btn" type="submit">Continue to seat selection</button>
        </form>
    </section>
</main>

@await Component.InvokeAsync("DashboardPanel")
<script src="~/js/dashboard.js" asp-append-version="true"></script>
