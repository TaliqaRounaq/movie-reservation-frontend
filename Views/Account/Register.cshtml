@model CineBook.Models.DTOs.RegisterRequestDto
@{
    ViewData["Title"] = "Register";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CineGo — Register</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https:cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<script>(function(){document.documentElement.setAttribute('data-theme',localStorage.getItem('cinebook-theme') || 'dark');})();</script>
<style>
  body{ min-height:100vh; display:flex; align-items:center; justify-content:center; }
  .cb-auth-card{ width:100%; max-width:420px; background:var(--velvet-950); border:1px solid var(--border-soft); border-radius:20px; padding:32px; box-shadow:0 30px 80px var(--shadow-color); }
  .cb-auth-tabs{ display:flex; gap:24px; margin-bottom:24px; border-bottom:1px solid var(--border-soft); }
  .cb-auth-tab{ font-family:'Bebas Neue', sans-serif; font-size:32px; letter-spacing:1px; color:var(--text-muted); text-decoration:none; padding-bottom:12px; position:relative; background:none; border:none; cursor:pointer; }
  .cb-auth-tab.active{ color:var(--text-primary); }
  .cb-auth-tab.active::after{ content:""; position:absolute; left:0; right:0; bottom:-1px; height:2px; background:var(--gold); border-radius:2px; }
  .form-label{ font-size:13px; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; color:var(--text-secondary); }
  .form-control{ background:var(--velvet-800); border:1px solid var(--border-soft); color:var(--text-primary); height:40px; }
  .form-control:focus{ background:var(--velvet-900); border-color:var(--gold); color:var(--text-primary); box-shadow:none; }
  .btn-cb-primary{ width:100%; height:40px; border:none; border-radius:8px; background:linear-gradient(135deg, var(--gold-soft), var(--gold)); color:var(--on-accent); font-weight:600; letter-spacing:0.04em; text-transform:uppercase; }
  .btn-cb-primary:hover{ filter:brightness(1.06); color:var(--on-accent); }
  .cb-divider{ display:flex; align-items:center; gap:16px; margin:20px 0; color:var(--text-muted); font-size:13px; }
  .cb-divider::before, .cb-divider::after{ content:""; flex:1; height:1px; background:var(--border-soft); }
  .btn-cb-social{ flex:1; height:40px; border-radius:8px; background:transparent; border:1px solid var(--border-soft); color:var(--text-primary); font-weight:600; display:flex; align-items:center; justify-content:center; gap:10px; }
  .btn-cb-social:hover{ border-color:var(--border-strong); background:var(--surface-highlight); color:var(--text-primary); }
  .cb-switch-text{ text-align:center; font-size:13px; color:var(--text-secondary); margin-top:20px; }
  .cb-switch-text a{ color:var(--gold-soft); font-weight:600; }
</style>
</head>
<body>

<div class="cb-auth-card">

    <div class="cb-auth-tabs">
        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Query["returnUrl"]" class="cb-auth-tab">Login</a>
        <button class="cb-auth-tab active" type="button">Register</button>
    </div>

    <form id="register-form" method="post" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewBag.ReturnUrl" novalidate>
        <div class="mb-3">
            <label class="form-label" for="register-name">Full name</label>
            <input asp-for="Name" id="register-name" type="text" class="form-control" placeholder="John Doe" required autocomplete="name">
        </div>
        <div class="mb-3">
            <label class="form-label" for="register-email">Email address</label>
            <input asp-for="Email" id="register-email" type="email" class="form-control" placeholder="you@example.com" required autocomplete="email">
        </div>
        <div class="row g-2 mb-3">
            <div class="col-6">
                <label class="form-label" for="register-password">Password</label>
                <input asp-for="Password" id="register-password" type="password" class="form-control" placeholder="Create password" required minlength="6" autocomplete="new-password">
            </div>
            <div class="col-6">
                <label class="form-label" for="register-confirm">Confirm password</label>
                <input asp-for="ConfirmPassword" id="register-confirm" type="password" class="form-control" placeholder="Re-enter password" required minlength="6" autocomplete="new-password">
            </div>
        </div>

        @if (ViewBag.Error != null)
        {
            <p class="text-danger small" role="alert">@ViewBag.Error</p>
        }

        <button type="submit" class="btn btn-cb-primary mb-3">Create Account</button>

        <div class="cb-divider">or continue with</div>

        <div class="d-flex gap-2 mb-3">
            <button type="button" class="btn btn-cb-social">
                <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#EA4335" d="M12 10.2v3.9h5.5c-.24 1.4-1.7 4.1-5.5 4.1-3.3 0-6-2.7-6-6.1s2.7-6.1 6-6.1c1.9 0 3.1.8 3.9 1.5l2.7-2.6C16.9 3.3 14.7 2.3 12 2.3 6.9 2.3 2.7 6.5 2.7 11.6S6.9 20.9 12 20.9c6.9 0 8.9-4.8 8.9-7.3 0-.5-.1-.9-.1-1.3H12z"/></svg>
                Google
            </button>
            <button type="button" class="btn btn-cb-social">
                <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#1877F2" d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z"/></svg>
                Facebook
            </button>
        </div>

        <div class="cb-switch-text">
            Already have an account? <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Query["returnUrl"]">Log in</a>
        </div>
    </form>

</div>

@* <script src="https:cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>  *@
</body>
</html>